<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#171715">
  <title>Private Screening</title>
  <style>
    :root { color-scheme: dark; --bg:#171715; --text:#f0eee8; --muted:#93918a; --accent:#d7ff64; }
    * { box-sizing:border-box; }
    html,body { margin:0; min-height:100%; background:var(--bg); }
    body { font-family:Arial,Helvetica,sans-serif; color:var(--text); }
    [hidden] { display:none !important; }
    .screen { min-height:100vh; min-height:100svh; display:flex; align-items:center; justify-content:center; padding:48px 24px; }
    .pin-content { width:100%; max-width:390px; text-align:center; }
    .movie-content { width:100%; max-width:1000px; text-align:center; }
    .eyebrow { color:var(--accent); font-size:10px; font-weight:700; letter-spacing:3px; margin-bottom:28px; }
    h1 { color:var(--text); font-size:clamp(32px,6vw,54px); line-height:1.08; letter-spacing:-2px; font-weight:600; margin:0 0 18px; }
    .description,.movie-note { color:var(--muted); font-size:14px; line-height:1.6; }
    #pin-form { margin-top:34px; }
    #pin-input { display:block; width:100%; height:64px; border:1px solid #484840; border-radius:8px; background:#20201d; color:var(--text); text-align:center; font-size:26px; letter-spacing:12px; padding:0 12px; outline:none; }
    #pin-input:focus { border-color:var(--accent); }
    #pin-form button { width:100%; min-height:56px; border:0; border-radius:8px; margin-top:12px; padding:14px 20px; background:var(--accent); color:#171715; font-size:14px; font-weight:700; cursor:pointer; }
    #pin-form button:hover { background:#e4ff9b; }
    #pin-error { min-height:20px; color:#ff8989; font-size:13px; }
    .video-frame { position:relative; width:100%; aspect-ratio:16/9; margin-top:34px; overflow:hidden; background:#090909; border:1px solid #363630; border-radius:10px; }
    .video-placeholder,#movie-player { position:absolute; inset:0; width:100%; height:100%; }
    .video-placeholder { display:flex; flex-direction:column; justify-content:center; align-items:center; gap:16px; background:radial-gradient(ellipse at center,#30302a 0%,#10100f 70%); }
    .video-placeholder p { margin:0; color:#c0bfb6; font-size:13px; }
    .timestamp { color:#77766f; font-size:11px; letter-spacing:2px; }
    #play-button { display:flex; align-items:center; justify-content:center; width:68px; height:68px; flex-shrink:0; border:0; border-radius:50%; background:var(--accent); color:#171715; cursor:pointer; transition:transform .2s ease; }
    #play-button:hover { transform:scale(1.08); }
    .play-icon { font-size:23px; margin-left:4px; }
    #movie-player { display:none; border:0; background:#000; }
    .movie-note { margin-top:18px; }
    @media(max-width:600px) { .screen { padding:32px 18px; } h1 { letter-spacing:-1.5px; } .video-frame { border-radius:6px; } }
  </style>
</head>
<body>
  <main id="film-site">
    <section id="pin-screen" class="screen">
      <div class="pin-content">
        <div class="eyebrow">PRIVATE SCREENING</div>
        <h1>Для тебя</h1>
        <p class="description">Введи код, чтобы продолжить</p>
        <form id="pin-form">
          <input id="pin-input" type="password" inputmode="numeric" maxlength="4" pattern="[0-9]{4}" placeholder="••••" autocomplete="off" aria-label="Пин-код" required>
          <button type="submit">Открыть фильм ↗</button>
          <p id="pin-error" role="alert" aria-live="polite"></p>
        </form>
      </div>
    </section>
    <section id="movie-screen" class="screen" hidden>
      <div class="movie-content">
        <div class="eyebrow">PRIVATE SCREENING</div>
        <h1>Приятного просмотра.</h1>
        <div class="video-frame">
          <div id="video-placeholder" class="video-placeholder">
            <button id="play-button" type="button" aria-label="Начать просмотр"><span class="play-icon">▶</span></button>
            <p>Нажми, чтобы начать просмотр</p>
            <span class="timestamp">01:44:56</span>
          </div>
          <iframe id="movie-player" title="Видеоплеер VK Видео" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
        <p class="movie-note">Фильм начинается с нужного момента.</p>
      </div>
    </section>
  </main>
  <script>
    (() => {
      // Простая блокировка интерфейса, не защита от технического обхода.
      const PIN_CODE = "5512";
      const VIDEO_EMBED_URL = "https://vkvideo.ru/video_ext.php?oid=-232125504&id=456239182&hd=2";
      // VK может не поддерживать параметр времени в этом формате.
      const START_TIME = "01h44m56s";
      const pinScreen = document.getElementById("pin-screen");
      const movieScreen = document.getElementById("movie-screen");
      const pinForm = document.getElementById("pin-form");
      const pinInput = document.getElementById("pin-input");
      const pinError = document.getElementById("pin-error");
      const playButton = document.getElementById("play-button");
      const placeholder = document.getElementById("video-placeholder");
      const player = document.getElementById("movie-player");
      pinForm.addEventListener("submit", (event) => {
        event.preventDefault();
        if (pinInput.value === PIN_CODE) {
          pinError.textContent = "";
          pinScreen.hidden = true;
          movieScreen.hidden = false;
        } else {
          pinError.textContent = "Неверный код. Попробуй ещё раз.";
          pinInput.value = "";
          pinInput.focus();
        }
      });
      playButton.addEventListener("click", () => {
        try {
          const url = new URL(VIDEO_EMBED_URL);
          url.searchParams.set("t", START_TIME);
          url.searchParams.set("autoplay", "1");
          player.src = url.toString();
          player.style.display = "block";
          placeholder.style.display = "none";
        } catch (_) {
          placeholder.querySelector("p").textContent = "Не удалось открыть видео. Проверь ссылку.";
        }
      });
    })();
  </script>
</body>
</html>
